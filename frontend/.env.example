# ==============================================================================
# MediBridge Frontend Environment Template
# ==============================================================================
# Copy this file to frontend/.env for local client development.
# IMPORTANT: All variables prefixed with VITE_ are embedded into the client-side
# bundle and are publicly visible to anyone inspecting the browser.
# NEVER place backend secrets, database URIs, encryption keys, or private API keys here.

# Backend API Endpoint
VITE_API_URL=http://localhost:5000/api/v1

# Application Metadata
VITE_APP_NAME=MediBridge

