# ==============================================================================
# MediBridge Backend Environment Template
# ==============================================================================
# Copy this file to backend/.env and replace placeholders with secure local values.
# NEVER commit real credentials or .env files to source control.

# Application Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB 7.0+ / MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/medibridge?retryWrites=true&w=majority

# Authentication Tokens
# Generate high-entropy 256-bit secrets using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cryptographic Keys (AES-256-GCM field-level encryption & HMAC confirmation tokens)
# Must be 32-byte (64 hex characters) cryptographically secure random keys.
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DO NOT use all-zero keys or predictable strings.
PHI_ENCRYPTION_KEY=
ACTION_TOKEN_SECRET=
PRESCRIPTION_SIGNING_KEY=

# Secure File Storage (local | s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads/secure_records
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# Multi-Provider AI Configuration (gemini | openai | anthropic | mock)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
AI_API_KEY=
GEMINI_API_KEY=
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=15000

# Transactional Email Service
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="MediBridge Alerts <no-reply@medibridge.internal>"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# Hospital admin bootstrap (used ONLY by `npm run bootstrap:hospital-admin`)
# Creates the first hospital + its hospital admin account. Idempotent.
# Password: min 10 chars incl. a letter and a number. Never commit real values.
# ------------------------------------------------------------------------------
BOOTSTRAP_HOSPITAL_NAME=
BOOTSTRAP_HOSPITAL_ADDRESS=
BOOTSTRAP_HOSPITAL_PHONE=
BOOTSTRAP_HOSPITAL_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# Local/test accounts (used ONLY by `npm run seed:test-users`)
# The script refuses to run unless NODE_ENV=test, or MONGODB_URI points to
# localhost/127.0.0.1, or the database name contains "test".
# ------------------------------------------------------------------------------
TEST_USERS_PASSWORD=

# Appointment rules
PATIENT_CANCEL_CUTOFF_HOURS=2
DOCTOR_INVITE_TTL_HOURS=72
